{
    "name": "thespeakeasy-server",
    "version": "1.0.0",
    "description": "TheSpeakEasy Chat Application Server",
    "main": "src/index.js",
    "type": "module",
    "engines": {
        "node": "18.x",
        "npm": "9.x"
    },
    "scripts": {
        "start": "node src/index.js",
        "dev": "nodemon src/index.js",
        "lint": "eslint src/**/*.js",
        "format": "prettier --write \"src/**/*.js\"",
        "test": "jest",
        "build": "mkdir -p dist && cp -r src/* dist/",
        "clean": "rimraf dist"
    },
    "dependencies": {
        "@signalapp/libsignal-client": "^0.32.1",
        "axios": "^1.13.5",
        "bcryptjs": "^2.4.3",
        "compression": "^1.8.1",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.22.1",
        "express-rate-limit": "^6.9.0",
        "express-validator": "^7.3.1",
        "helmet": "^7.0.0",
        "jsonwebtoken": "^9.0.1",
        "mongoose": "^8.9.5",
        "morgan": "^1.10.1",
        "multer": "^2.0.2",
        "nodemailer": "^7.0.11",
        "socket.io": "^4.7.2",
        "winston": "^3.10.0",
        "zod": "^3.22.2"
    },
    "devDependencies": {
        "eslint": "^8.47.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "jest": "^29.6.3",
        "nodemon": "^3.0.1",
        "prettier": "^3.0.2",
        "rimraf": "^5.0.0",
        "supertest": "^6.3.3"
    }
}